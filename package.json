{
  "name": "editor-landings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/renombrar-build.mjs",
    "preview": "vite preview",
    "gen:lenis": "node tools/gen-lenis.mjs",
    "test:firefox": "playwright test -c tests/playwright.config.js",
    "test:selenium": "node --test --test-reporter=spec tests/selenium.test.mjs",
    "test:vistaprevia": "node tests/vista-previa.mjs",
    "test:persistencia": "npm run build && node tests/inspector-persistencia.mjs",
    "test:fondo": "npm run build && node tests/fondo.mjs",
    "test:inspector": "node tests/controles.mjs && node tests/inspector.mjs"
  },
  "dependencies": {
    "lenis": "^1.3.27",
    "motion": "^14.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "selenium-webdriver": "^4.51.0",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
